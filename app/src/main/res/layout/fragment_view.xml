<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.view.ViewFragment">

    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="-1dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_bg_view"
        tools:layout_editor_absoluteX="-16dp"
        tools:layout_editor_absoluteY="125dp" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/app_color4"
    app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/imvImage"
        android:scaleType="centerCrop"
        android:src="@drawable/img_permission" />



    <!--    btnEdit-->
    <!--    <ImageView-->
    <!--        android:id="@+id/btnEdit"-->
    <!--        android:layout_width="32dp"-->
    <!--        android:visibility="gone"-->
    <!--        android:layout_height="32dp"-->
    <!--        android:layout_marginTop="10dp"-->
    <!--        android:layout_marginEnd="16dp"-->
    <!--        android:src="@drawable/ic_edit_2"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:layout_constraintTop_toBottomOf="@id/layoutActionBar" />-->

    <!--        tvSuccess-->


    <!--    lnlBottom-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintDimensionRatio="2.76:0.37"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">




        <FrameLayout
            android:id="@+id/btnBottomLeft"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.24:0.37"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imgViewdBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="1.8dp"
                android:layout_marginTop="1.8dp"
                android:background="@drawable/frame_bg_add"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/imgViewFor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="1.8dp"
                android:layout_marginBottom="1.8dp"
                android:scaleType="fitXY"
                android:src="@drawable/frame_select_add" />
            <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                android:id="@+id/txtLeft"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/my_creation"
                android:textColor="@color/white"
                android:fontFamily="@font/atma_bold"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="1dp"
                android:textSize="20sp" />
        </FrameLayout>



        <FrameLayout
            android:id="@+id/btnBottomRight"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1.24:0.37"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imgViewBg1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="1.8dp"
                android:layout_marginTop="1.8dp"
                android:background="@drawable/frame_bg_add"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/imgViewFor1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="1.8dp"
                android:layout_marginBottom="1.8dp"
                android:scaleType="fitXY"
                android:src="@drawable/frame_select_add" />
            <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                android:id="@+id/txtRight"
                style="@style/single_marquee"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="@string/download"

                android:textColor="@color/white"
                android:fontFamily="@font/atma_bold"
                app:outerStrokeColor="@color/app_color"
                app:outerStrokeWidth="1dp"
                android:textSize="20sp" />
        </FrameLayout>
        <!--        btnBottomRight-->

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>