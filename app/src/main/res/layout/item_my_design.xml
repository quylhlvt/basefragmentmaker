<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginStart="7.3dp"
            android:layout_marginTop="7.3dp"
            app:cardCornerRadius="10dp"
            android:elevation="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/shadown_blue2"
            />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginBottom="7.3dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/app_color3"
            android:layout_marginEnd="7.3dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp">



                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginEnd="1dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:cardCornerRadius="10dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/app_color2"
                    app:cardBackgroundColor="@color/color_bg_item">

                    <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_permission" />
                    <View
                        android:visibility="gone"
                        android:id="@+id/shadownForcus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/shadown_blue2"/>
                    <ImageView
                        android:id="@+id/btnDelete"
                        android:layout_width="24dp"
                        android:layout_margin="2dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_delete" />

                    <!--        btnEdit-->
<!--                    <ImageView-->
<!--                        android:id="@+id/btnEdit"-->
<!--                        android:layout_margin="2dp"-->
<!--                        android:layout_width="24dp"-->
<!--                        android:layout_height="24dp"-->
<!--                        android:src="@drawable/ic_edit" />-->

                    <!--        btnSelect-->
                    <ImageView
                        android:id="@+id/btnSelect"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_margin="2dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_not_select"
                        android:visibility="gone" />

                </com.google.android.material.card.MaterialCardView>



            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>