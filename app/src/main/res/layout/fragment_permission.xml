<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.onboarding.permission.PermissionFragment">
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_bg_lang"
        android:scaleType="fitXY"
        android:elevation="-1dp"
        android:adjustViewBounds="true"/>

    <ImageView
        android:id="@+id/imgPermission"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="44dp"
        app:layout_constraintDimensionRatio="1:1"
        android:adjustViewBounds="true"
        android:src="@drawable/img_permission"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/txtPermission"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutActionBar" />

    <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextViewPermission
        android:id="@+id/txtPermission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:fontFamily="@font/atma_bold"
        android:textSize="16sp"
        android:textColor="@color/app_color"
        app:outerStrokeColor="@color/white"
        app:outerStrokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@+id/scrollView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/tvContinue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical">

            <!-- btnStorage-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnStorage"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="1dp">
                <ImageView
                    android:id="@+id/imgLangBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/frame_bg_lang"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/imgLangFor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/frame_select_language" />

                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    style="@style/single_marquee"
                    android:text="@string/storage"
                    android:textColor="@color/app_color"
                    app:outerStrokeColor="@color/white"
                    app:outerStrokeWidth="1dp"
                    android:fontFamily="@font/atma_bold"
                    app:layout_constraintTop_toTopOf="@+id/imgLangFor"
                    app:layout_constraintBottom_toBottomOf="@+id/imgLangFor"
                    app:layout_constraintStart_toStartOf="@+id/imgLangFor"
                    android:textSize="20sp" />

                <ImageView
                    android:id="@+id/swPermission"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/switch_off"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toTopOf="@+id/imgLangFor"
                    app:layout_constraintBottom_toBottomOf="@+id/imgLangFor"
                    app:layout_constraintEnd_toEndOf="@+id/imgLangFor" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- btnNotification-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnNotification"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_frame_permission">
                <ImageView
                    android:id="@+id/imgLangBg1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/frame_bg_lang"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/imgLangFor1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/frame_select_language" />
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    style="@style/single_marquee"
                    android:fontFamily="@font/atma_bold"
                    android:text="@string/notification"
                    android:textColor="@color/app_color"
                    app:outerStrokeColor="@color/white"
                    app:outerStrokeWidth="1dp"
                    app:layout_constraintTop_toTopOf="@+id/imgLangFor1"
                    app:layout_constraintBottom_toBottomOf="@+id/imgLangFor1"
                    app:layout_constraintStart_toStartOf="@+id/imgLangFor1"
                    android:textSize="20sp" />

                <ImageView
                    android:id="@+id/swNotification"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="8.5dp"
                    android:layout_marginBottom="11.5dp"
                    android:src="@drawable/switch_off"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toTopOf="@+id/imgLangFor1"
                    app:layout_constraintBottom_toBottomOf="@+id/imgLangFor1"
                    app:layout_constraintEnd_toEndOf="@+id/imgLangFor1"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>
    <com.oc.catemoji.catoc.core.extention.ShadowTextView1
        android:id="@+id/tvContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="270dp"
        android:gravity="center"
        android:fontFamily="@font/atma_bold"
        android:text="@string/continue_per"
        android:textColor="@color/app_color"
        android:shadowColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>