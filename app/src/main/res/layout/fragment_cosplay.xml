<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.cosplay.CosplayFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:elevation="-1dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_bg_view" />

    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imgRandom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="13dp"
            android:layout_marginTop="13dp"
            android:elevation="0dp"
            app:cardBackgroundColor="@color/shadown_blue2"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginEnd="13dp"
            android:layout_marginBottom="13dp"
            app:cardBackgroundColor="@color/app_color3"
            app:cardCornerRadius="10dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="15dp">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="2dp"
                    app:cardBackgroundColor="@color/color_bg_item"
                    app:cardCornerRadius="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/app_color2"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/imvImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_permission" />



                </com.google.android.material.card.MaterialCardView>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/random"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="50dp"
        app:layout_constraintDimensionRatio="1.56:0.40"
        app:layout_constraintEnd_toStartOf="@+id/show"
        app:layout_constraintStart_toStartOf="@+id/imgRandom"
        app:layout_constraintTop_toBottomOf="@+id/imgRandom"
        app:strokeColor="@color/app_color2"
        app:strokeWidth="1dp">
        <ImageView
            android:id="@+id/imgRandomBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/frame_bg_type_lang"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/imgRandomFor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_btn_type_selected" />
        <ImageView
            android:id="@+id/imgIcRandom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@+id/imgRandomFor"
            android:layout_marginStart="15dp"
            android:layout_marginVertical="6dp"
            app:layout_constraintTop_toTopOf="@+id/imgRandomFor"
            app:layout_constraintBottom_toBottomOf="@+id/imgRandomFor"
            android:layout_marginEnd="2dp"

            app:layout_constraintDimensionRatio="1:1"
            android:scaleType="fitXY"
            android:src="@drawable/ic_ramdom" />
        <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
            android:id="@+id/txtRandom"
            style="@style/single_marquee"
            android:layout_width="0dp"
            android:layout_marginStart="-8dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/imgIcRandom"
            app:layout_constraintEnd_toEndOf="@+id/imgRandomFor"
            app:layout_constraintTop_toTopOf="@+id/imgRandomFor"
            app:layout_constraintBottom_toBottomOf="@+id/imgRandomFor"
            android:fontFamily="@font/atma_bold"
            android:gravity="center"
            android:text="@string/random"
            android:textColor="@color/white"
            app:outerStrokeColor="@color/app_color"
            app:outerStrokeWidth="2dp"
            android:textSize="20sp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/show"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_cosplay1"
        app:layout_constraintDimensionRatio="1.56:0.40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/random"
        app:layout_constraintTop_toTopOf="@+id/random"
        app:strokeColor="@color/app_color2"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgShowBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/frame_bg_type_lang"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/imgShowFor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_btn_type_selected" />
        <ImageView
            android:id="@+id/imgIcShow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@+id/imgShowFor"
            android:layout_marginStart="15dp"
            android:layout_marginVertical="6dp"
            app:layout_constraintTop_toTopOf="@+id/imgShowFor"
            app:layout_constraintBottom_toBottomOf="@+id/imgShowFor"
            android:layout_marginEnd="2dp"

            app:layout_constraintDimensionRatio="1:1"
            android:scaleType="fitXY"
            android:src="@drawable/ic_cosplay" />
        <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
            android:id="@+id/txtShow"
            style="@style/single_marquee"
            android:layout_width="0dp"
            android:layout_marginStart="-8dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/imgIcShow"
            app:layout_constraintEnd_toEndOf="@+id/imgShowFor"
            app:layout_constraintTop_toTopOf="@+id/imgShowFor"
            app:layout_constraintBottom_toBottomOf="@+id/imgShowFor"
            android:fontFamily="@font/atma_bold"
            android:gravity="center"
            android:text="@string/cosplay"
            android:textColor="@color/white"
            app:outerStrokeColor="@color/app_color"
            app:outerStrokeWidth="2dp"
            android:textSize="20sp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:clipToPadding="false"
        android:id="@+id/showGuide"
        android:visibility="gone"
        android:clipToOutline="true"
        android:clipChildren="true"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:clipToOutline="false"
    android:clipChildren="false"
            >

            <FrameLayout
                android:layout_marginTop="30dp"
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
        android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent">

                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextViewCosplay
                    android:background="@drawable/context_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtGuile"
                    android:layout_gravity="center"
                    android:paddingHorizontal="10dp"
                    android:fontFamily="@font/baloo2_bold"
                    android:gravity="center"
                    android:textColor="@color/white"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="1dp"
                    android:paddingVertical="30dp"
                    android:lineSpacingMultiplier="0.8"
                    android:textSize="20sp" />
            </FrameLayout>
<FrameLayout
    app:layout_constraintBottom_toTopOf="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginHorizontal="80dp"
    android:layout_marginBottom="-20dp"
    app:layout_constraintDimensionRatio="1.68:0.36"
    android:background="@drawable/bg_title_coosplay">
<TextView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textColor="@color/app_color"
    android:textSize="20sp"
    android:text="@string/instruction"
    android:fontFamily="@font/atma_bold"
    android:gravity="center"
    style="@style/single_marquee"
    android:id="@+id/txtTilleShow"/>
</FrameLayout>


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/closeGuide"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="-5dp"

                android:src="@drawable/ic_close_guide"
              app:layout_constraintTop_toTopOf="@+id/frameLayout"
                app:layout_constraintEnd_toEndOf="@+id/frameLayout"
                 />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>




</androidx.constraintlayout.widget.ConstraintLayout>