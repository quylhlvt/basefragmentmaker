<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contrainColor"
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-20dp"
            android:paddingVertical="20dp"
            android:background="@drawable/frame_bg_dialog"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">





            <ir.kotlin.kavehcolorpicker.KavehColorPicker
                android:id="@+id/colorPickerView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                <ir.kotlin.kavehcolorpicker.KavehHueSlider
                    android:id="@+id/hueSlider"
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!--                btnDone-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bg"
                    android:layout_marginTop="16dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/txtContent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnCancle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="8dp"
                        app:layout_constraintDimensionRatio="1.56:0.40"
                        app:layout_constraintEnd_toStartOf="@+id/btnSave"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/app_color2"
                        app:strokeWidth="1dp">
                        <ImageView
                            android:id="@+id/imgCancleBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/frame_bg_type_lang"
                            android:scaleType="fitXY" />

                        <ImageView
                            android:id="@+id/imgCancleFor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_btn_type_selected" />

                        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                            android:id="@+id/txtCancle"
                            style="@style/single_marquee"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/imgCancleFor"
                            app:layout_constraintTop_toTopOf="@+id/imgCancleFor"
                            app:layout_constraintBottom_toBottomOf="@+id/imgCancleFor"
                            android:fontFamily="@font/atma_bold"
                            android:gravity="center"
                            android:text="@string/cancel"
                            android:textColor="@color/white"
                            app:outerStrokeColor="@color/app_color"
                            app:outerStrokeWidth="2dp"
                            android:textSize="20sp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="8dp"
                        app:layout_constraintDimensionRatio="1.56:0.40"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/btnCancle"
                        app:layout_constraintTop_toTopOf="@+id/btnCancle"
                        app:strokeColor="@color/app_color2"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/imgSaveBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/frame_bg_type_lang"
                            android:scaleType="fitXY" />

                        <ImageView
                            android:id="@+id/imgSaveFor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_btn_type_selected" />

                        <com.chibi.avatar.chibimaker.core.extention.OuterStrokeShadownTextView
                            android:id="@+id/txtSave"
                            style="@style/single_marquee"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/imgSaveFor"
                            app:layout_constraintTop_toTopOf="@+id/imgSaveFor"
                            app:layout_constraintBottom_toBottomOf="@+id/imgSaveFor"
                            android:fontFamily="@font/atma_bold"
                            android:gravity="center"
                            android:text="@string/save"
                            android:textColor="@color/white"
                            app:outerStrokeColor="@color/app_color"
                            app:outerStrokeWidth="2dp"
                            android:textSize="20sp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_title_coosplay"
            app:layout_constraintEnd_toEndOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"/>

        <TextView
            android:id="@+id/tvTitle"
            style="@style/single_marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:layout_marginHorizontal="110dp"

            android:fontFamily="@font/atma_bold"
            android:gravity="center"

            android:paddingHorizontal="5dp"
            android:text="@string/choose_color"
            android:textColor="@color/app_color"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

         />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>