<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.myPony.MyPonyFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_bg_lang" />
    <!-- layoutActionBar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!--    cvType-->
    <LinearLayout
        android:id="@+id/cvType"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="320">

            <!--            btnMyAvatar-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnMyAvatar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="156">

                <ImageView
                    android:id="@+id/imgMyponyBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/frame_bg_type_lang"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/imgMyponyFor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_type_selected" />
                <!--                imvFocusMyAvatar-->


                <!--                tvMyAvatar-->
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:id="@+id/tvMyAvatar"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="@+id/imgMyponyFor"
                    app:layout_constraintEnd_toEndOf="@+id/imgMyponyFor"
                    app:layout_constraintTop_toTopOf="@+id/imgMyponyFor"
                    app:layout_constraintBottom_toBottomOf="@+id/imgMyponyFor"
                    android:layout_marginVertical="1dp"
                    android:fontFamily="@font/atma_bold"
                    android:gravity="center"
                    android:text="@string/my_avatar"
                    android:textColor="@color/white"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="1.3dp"
                    android:textSize="20sp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8" />

            <!--            btnMyDesign-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnMyDesign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="156">

                <ImageView
                    android:id="@+id/imgMyponyBg2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/frame_bg_type_lang"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/imgMyponyFor2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_type_unselected" />

                <!--                tvMyDesign-->
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:id="@+id/tvMyDesign"
                    style="@style/single_marquee"
                    android:fontFamily="@font/atma_bold"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintStart_toStartOf="@+id/imgMyponyFor2"
                    app:layout_constraintEnd_toEndOf="@+id/imgMyponyFor2"
                    app:layout_constraintTop_toTopOf="@+id/imgMyponyFor2"
                    app:layout_constraintBottom_toBottomOf="@+id/imgMyponyFor2"
                    android:gravity="center"
                    android:text="@string/design"
                    android:textColor="@color/white"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="1.3dp"
                    android:textSize="20sp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleAvatar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="12dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvType"
        app:spanCount="2"
        tools:itemCount="9"
        tools:listitem="@layout/item_my_avatar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleDesign"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvType"
        tools:itemCount="9"
        tools:listitem="@layout/item_my_design" />


    <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
        android:id="@+id/noItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/atma_bold"
        android:gravity="center"
        android:text="@string/no_item_here"
        android:textColor="@color/app_color"
        android:visibility="gone"
        app:outerStrokeColor="@color/white"
        app:outerStrokeWidth="2dp"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/recycleAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvType" />


    <!--    lnlBottom-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lnlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mycreation"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"
            app:layout_constraintBottom_toTopOf="@+id/lnlBottomTop" />
        <!--        lnlBottomTop-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lnlBottomTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="25dp"
            android:orientation="horizontal"
            android:weightSum="288"
            app:layout_constraintBottom_toTopOf="@+id/llBottom"
            app:layout_constraintDimensionRatio="2.88:0.36">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnWhatsapp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="136"
                android:background="@drawable/bg_btn_whatsapp">

                <ImageView
                    android:id="@+id/imgWhatApp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_whatapp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWhatApp"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="@font/atma_bold"
                    android:gravity="center"
                    android:text="@string/add_to_whatsapp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imgWhatApp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnTelegram"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="136"
                android:background="@drawable/bg_btn_telegram">

                <ImageView
                    android:id="@+id/imgTelegram"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_telegram"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTelegram"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="@font/atma_bold"
                    android:gravity="center"
                    android:text="@string/add_to_telegram"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imgTelegram" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="6dp"
            android:orientation="horizontal"
            android:weightSum="276"
            android:layout_marginBottom="25dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="2.76:0.37">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="124">
                <ImageView
                    android:id="@+id/imgMyponyBg3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/frame_bg_type_lang"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/imgMyponyFor3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_type_selected" />
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:id="@+id/tvShare"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="@font/atma_bold"
                    android:gravity="center"
                    android:text="@string/share"
                    app:layout_constraintStart_toStartOf="@+id/imgMyponyFor3"
                    app:layout_constraintEnd_toEndOf="@+id/imgMyponyFor3"
                    app:layout_constraintTop_toTopOf="@+id/imgMyponyFor3"
                    app:layout_constraintBottom_toBottomOf="@+id/imgMyponyFor3"
                    android:textColor="@color/white"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="1.3dp"
                    android:textSize="16sp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="28" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="124">
                <ImageView
                    android:id="@+id/imgMyponyBg4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/frame_bg_type_lang"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/imgMyponyFor4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_btn_type_selected" />
                <com.oc.catemoji.catoc.core.extention.OuterStrokeShadownTextView
                    android:id="@+id/tvDownload"
                    style="@style/single_marquee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="@font/atma_bold"
                    android:gravity="center"
                    android:text="@string/download"
                    android:textColor="@color/white"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="1.3dp"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="@+id/imgMyponyFor4"
                    app:layout_constraintEnd_toEndOf="@+id/imgMyponyFor4"
                    app:layout_constraintTop_toTopOf="@+id/imgMyponyFor4"
                    app:layout_constraintBottom_toBottomOf="@+id/imgMyponyFor4"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>